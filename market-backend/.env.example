# Copiar a ".env" (mismo directorio que docker-compose.yml) y llenar valores
# reales antes de "docker compose up -d". Nunca commitear el ".env" real.

# --- Postgres ---
POSTGRES_DB=market
POSTGRES_USER=market
POSTGRES_PASSWORD=cambiar-esta-clave

# --- Backend / app.security ---
# Debe incluir el/los origin(es) reales del cliente (market-flutter web,
# market-backoffice), separados por coma — incluyendo el origin público
# donde queda expuesto el backoffice de abajo. Sin esto el navegador
# bloquea todo request por CORS (ver CLAUDE.md de market-flutter para el
# gotcha ya conocido con este mismo síntoma).
CORS_ALLOWED_ORIGINS=https://tu-dominio.com

# Identidad del emisor/audiencia de los JWT emitidos. Los valores de abajo son los
# mismos que usa el proyecto en desarrollo — cambiarlos aquí solo si de verdad se
# necesita una identidad distinta por deploy.
JWT_ISSUER=market-backend
JWT_AUDIENCE=market-clients

# --- Backoffice (Vue/Vite) ---
# URL PÚBLICA del backend, tal como la alcanza el navegador — se empaca en
# el bundle al construir la imagen (Vite es build-time, no runtime). Nunca
# el nombre interno del servicio docker ("backend"). Debe ser uno de los
# origins de CORS_ALLOWED_ORIGINS de arriba.
BACKOFFICE_API_BASE_URL=https://tu-dominio.com

# IPs/CIDRs del proxy o load balancer que queda delante del backend (si
# hay uno) — vacío si el backend recibe tráfico directo.
TRUSTED_PROXIES=

# Usuario admin sembrado en el primer arranque. Cambiar la clave por una
# real — nunca dejar el default de desarrollo en producción (ProdSafetyGuard
# rechaza el arranque si detecta la contraseña conocida de desarrollo). Después
# del primer arranque exitoso, poner SEED_ENABLED=false y reiniciar (evita
# volver a intentar sembrar el admin en cada reinicio del contenedor) — el
# default de docker-compose.yml ya es SEED_ENABLED=false si se omite esta línea.
SEED_ENABLED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=cambiar-esta-clave-tambien

# --- Negocio ---
# Zona horaria para los cortes de "hoy"/"mes" del dashboard (formato IANA).
BUSINESS_TIMEZONE=America/Guatemala

# --- Backup automático (pg_dump programado) ---
# Cada cuántos segundos corre el backup (default 86400 = 24h).
BACKUP_INTERVAL_SECONDS=86400
# Cuántos días de dumps viejos conservar antes de borrarlos (default 14).
BACKUP_RETENTION_DAYS=14
