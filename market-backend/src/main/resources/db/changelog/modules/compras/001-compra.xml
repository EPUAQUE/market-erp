<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="compras-001-compra" author="market-backend">
        <createTable tableName="compra">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="proveedor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tienda_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="fecha" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="estado" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="compra" baseColumnNames="proveedor_id"
                referencedTableName="proveedor" referencedColumnNames="id"
                constraintName="fk_compra_proveedor" onDelete="RESTRICT"/>
        <addForeignKeyConstraint
                baseTableName="compra" baseColumnNames="tienda_id"
                referencedTableName="tienda" referencedColumnNames="id"
                constraintName="fk_compra_tienda" onDelete="RESTRICT"/>
    </changeSet>

    <changeSet id="compras-001-linea-compra" author="market-backend">
        <createTable tableName="linea_compra">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="compra_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="producto_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="cantidad" type="NUMERIC(12,3)">
                <constraints nullable="false"/>
            </column>
            <column name="costo_unitario" type="NUMERIC(12,4)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="linea_compra" baseColumnNames="compra_id"
                referencedTableName="compra" referencedColumnNames="id"
                constraintName="fk_linea_compra_compra" onDelete="CASCADE"/>
        <addForeignKeyConstraint
                baseTableName="linea_compra" baseColumnNames="producto_id"
                referencedTableName="producto" referencedColumnNames="id"
                constraintName="fk_linea_compra_producto" onDelete="RESTRICT"/>
    </changeSet>

    <changeSet id="compras-001-seed-permisos" author="market-backend">
        <insert tableName="permiso">
            <column name="codigo" value="COMPRAS_VER"/>
            <column name="descripcion" value="Ver órdenes de compra"/>
        </insert>
        <insert tableName="permiso">
            <column name="codigo" value="COMPRAS_CREAR"/>
            <column name="descripcion" value="Crear órdenes de compra en borrador"/>
        </insert>
        <insert tableName="permiso">
            <column name="codigo" value="COMPRAS_RECIBIR"/>
            <column name="descripcion" value="Recibir una compra y registrar su ingreso a inventario"/>
        </insert>
        <insert tableName="permiso">
            <column name="codigo" value="COMPRAS_ANULAR"/>
            <column name="descripcion" value="Anular una compra en borrador"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'COMPRAS_VER')"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'COMPRAS_CREAR')"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'COMPRAS_RECIBIR')"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'COMPRAS_ANULAR')"/>
        </insert>
    </changeSet>
</databaseChangeLog>
