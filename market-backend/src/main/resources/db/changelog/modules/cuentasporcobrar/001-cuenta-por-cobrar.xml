<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="cuentasporcobrar-001-cuenta-por-cobrar" author="market-backend">
        <createTable tableName="cuenta_por_cobrar">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="venta_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_cuenta_por_cobrar_venta"/>
            </column>
            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tienda_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_emision" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_vencimiento" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="monto_original" type="NUMERIC(12,4)">
                <constraints nullable="false"/>
            </column>
            <column name="saldo_pendiente" type="NUMERIC(12,4)">
                <constraints nullable="false"/>
            </column>
            <column name="estado" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="cuenta_por_cobrar" baseColumnNames="venta_id"
                referencedTableName="venta" referencedColumnNames="id"
                constraintName="fk_cuenta_por_cobrar_venta" onDelete="RESTRICT"/>
        <addForeignKeyConstraint
                baseTableName="cuenta_por_cobrar" baseColumnNames="cliente_id"
                referencedTableName="cliente" referencedColumnNames="id"
                constraintName="fk_cuenta_por_cobrar_cliente" onDelete="RESTRICT"/>
        <addForeignKeyConstraint
                baseTableName="cuenta_por_cobrar" baseColumnNames="tienda_id"
                referencedTableName="tienda" referencedColumnNames="id"
                constraintName="fk_cuenta_por_cobrar_tienda" onDelete="RESTRICT"/>
    </changeSet>

    <changeSet id="cuentasporcobrar-001-cobro" author="market-backend">
        <createTable tableName="cobro">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="cuenta_por_cobrar_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="fecha" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="monto" type="NUMERIC(12,4)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="cobro" baseColumnNames="cuenta_por_cobrar_id"
                referencedTableName="cuenta_por_cobrar" referencedColumnNames="id"
                constraintName="fk_cobro_cuenta_por_cobrar" onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="cuentasporcobrar-001-seed-permisos" author="market-backend">
        <insert tableName="permiso">
            <column name="codigo" value="CUENTAS_POR_COBRAR_VER"/>
            <column name="descripcion" value="Ver cuentas por cobrar a clientes"/>
        </insert>
        <insert tableName="permiso">
            <column name="codigo" value="CUENTAS_POR_COBRAR_COBRAR"/>
            <column name="descripcion" value="Registrar abonos a una cuenta por cobrar"/>
        </insert>
        <insert tableName="permiso">
            <column name="codigo" value="CUENTAS_POR_COBRAR_ANULAR"/>
            <column name="descripcion" value="Anular una cuenta por cobrar sin abonos"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'CUENTAS_POR_COBRAR_VER')"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'CUENTAS_POR_COBRAR_COBRAR')"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'CUENTAS_POR_COBRAR_ANULAR')"/>
        </insert>
    </changeSet>
</databaseChangeLog>
