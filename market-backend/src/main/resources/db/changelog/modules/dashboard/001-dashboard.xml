<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Módulo sin tabla propia: agrega datos de otros módulos en tiempo real, no persiste nada. -->
    <changeSet id="dashboard-001-seed-permisos" author="market-backend">
        <insert tableName="permiso">
            <column name="codigo" value="DASHBOARD_VER"/>
            <column name="descripcion" value="Ver el resumen de indicadores de una tienda"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'DASHBOARD_VER')"/>
        </insert>
    </changeSet>
</databaseChangeLog>
