<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Confirmado en producción (2026-09-02): 2 filas de movimiento_inventario con
         costo_unitario a 4 decimales reales (7.7833) — no es un error de captura, es
         el costo promedio ponderado que VentaServiceImpl graba en el kardex de cada
         movimiento VENTA (ver su javadoc: "el costo registrado... es el costo
         [promedio] en el momento"), calculado con precisión de 4 decimales antes de
         esta fase. Redondear un valor calculado es seguro (a diferencia de truncar un
         precio que alguien tecleó); se hace en un changeset aparte, antes de fijar la
         escala de la columna, para que quede explícito en el historial por qué se tocó
         un dato existente. costo_promedio_actual se redondea por la misma razón
         aunque hoy no se haya visto un caso real — se deriva de costo_unitario.
         movimiento_inventario es append-only (trigger de la Fase de kardex, ver
         inventario/001-inventario.xml) — ningún UPDATE pasa, ni siquiera este, así
         que el trigger se desactiva solo para esta sentencia puntual y se reactiva
         de inmediato después (mismo patrón que cualquier corrección de datos
         históricos sobre una tabla append-only: la excepción es explícita y
         acotada a una sola sentencia, no una relajación permanente del invariante). -->
    <changeSet id="inventario-004a-redondear-costos-existentes" author="market-backend">
        <sql splitStatements="true">
            ALTER TABLE movimiento_inventario DISABLE TRIGGER trg_movimiento_inventario_append_only;
            UPDATE movimiento_inventario SET costo_unitario = ROUND(costo_unitario, 2)
                WHERE costo_unitario != ROUND(costo_unitario, 2);
            ALTER TABLE movimiento_inventario ENABLE TRIGGER trg_movimiento_inventario_append_only;
            UPDATE inventario SET costo_promedio_actual = ROUND(costo_promedio_actual, 2)
                WHERE costo_promedio_actual != ROUND(costo_promedio_actual, 2);
        </sql>
    </changeSet>

    <!-- Ver ventas/009-monto-dos-decimales.xml: mismo cambio, misma razón (dinero
         físico a 2 decimales). costo_promedio_actual es el promedio ponderado
         calculado a partir de costo_unitario, así que se ajusta junto con él. -->
    <changeSet id="inventario-004-monto-dos-decimales" author="market-backend">
        <preConditions onFail="HALT">
            <sqlCheck expectedResult="0">
                SELECT count(*) FROM movimiento_inventario WHERE costo_unitario != ROUND(costo_unitario, 2)
            </sqlCheck>
            <sqlCheck expectedResult="0">
                SELECT count(*) FROM inventario WHERE costo_promedio_actual != ROUND(costo_promedio_actual, 2)
            </sqlCheck>
        </preConditions>
        <sql>
            ALTER TABLE movimiento_inventario ALTER COLUMN costo_unitario TYPE NUMERIC(12,2);
            ALTER TABLE inventario ALTER COLUMN costo_promedio_actual TYPE NUMERIC(12,2);
        </sql>
        <rollback>
            <sql>
                ALTER TABLE movimiento_inventario ALTER COLUMN costo_unitario TYPE NUMERIC(12,4);
                ALTER TABLE inventario ALTER COLUMN costo_promedio_actual TYPE NUMERIC(12,4);
            </sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
