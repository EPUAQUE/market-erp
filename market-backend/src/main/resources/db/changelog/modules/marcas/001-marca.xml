<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="marcas-001-marca" author="market-backend">
        <createTable tableName="marca">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nombre" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_marca_nombre"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="marcas-001-seed-permisos" author="market-backend">
        <insert tableName="permiso">
            <column name="codigo" value="MARCAS_VER"/>
            <column name="descripcion" value="Listar marcas"/>
        </insert>
        <insert tableName="permiso">
            <column name="codigo" value="MARCAS_CREAR"/>
            <column name="descripcion" value="Crear marcas"/>
        </insert>
        <insert tableName="permiso">
            <column name="codigo" value="MARCAS_EDITAR"/>
            <column name="descripcion" value="Editar marcas"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'MARCAS_VER')"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'MARCAS_CREAR')"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'MARCAS_EDITAR')"/>
        </insert>
    </changeSet>
</databaseChangeLog>
