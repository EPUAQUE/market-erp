<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="proveedores-001-proveedor" author="market-backend">
        <createTable tableName="proveedor">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nit" type="VARCHAR(20)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_proveedor_nit"/>
            </column>
            <column name="nombre" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="direccion" type="VARCHAR(255)"/>
            <column name="telefono" type="VARCHAR(30)"/>
            <column name="correo" type="VARCHAR(150)"/>
            <column name="estado" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="proveedores-001-seed-permisos" author="market-backend">
        <insert tableName="permiso">
            <column name="codigo" value="PROVEEDORES_VER"/>
            <column name="descripcion" value="Listar proveedores"/>
        </insert>
        <insert tableName="permiso">
            <column name="codigo" value="PROVEEDORES_CREAR"/>
            <column name="descripcion" value="Crear proveedores"/>
        </insert>
        <insert tableName="permiso">
            <column name="codigo" value="PROVEEDORES_EDITAR"/>
            <column name="descripcion" value="Editar y activar/desactivar proveedores"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'PROVEEDORES_VER')"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'PROVEEDORES_CREAR')"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'PROVEEDORES_EDITAR')"/>
        </insert>
    </changeSet>
</databaseChangeLog>
