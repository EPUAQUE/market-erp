<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Módulo sin tabla propia: filtra y agrega datos de Ventas/Compras por rango de fechas, no persiste nada. -->
    <changeSet id="reportes-001-seed-permisos" author="market-backend">
        <insert tableName="permiso">
            <column name="codigo" value="REPORTES_VER"/>
            <column name="descripcion" value="Ver y generar reportes de ventas y compras de una tienda"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'REPORTES_VER')"/>
        </insert>
    </changeSet>
</databaseChangeLog>
