    <!-- Hasta ahora ENCARGADO_TIENDA y CAJERO solo tenían DASHBOARD_VER (y
         ENCARGADO_TIENDA, PRODUCTOS_VER) — cada módulo seedeaba permisos para
         ADMIN pero ninguno completó el resto de roles operativos. Este
         changelog corrige eso de una vez para ambos roles, siguiendo la
         matriz de permisos documentada en market-flutter (POS): CAJERO es hoy
         el rol funcional del "Vendedor" del brief (no existe un rol VENDEDOR
         separado todavía), ENCARGADO_TIENDA es superset de CAJERO. -->

    <changeSet id="seguridad-006-cajero-operativo" author="market-backend">
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'CAJERO')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'DASHBOARD_VER')"/>
        </insert>
