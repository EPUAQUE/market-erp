<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Fase 4 del plan (PLAN_MEJORAS.md): marca una cuenta para forzar el cambio de
         contraseña en el próximo login — usado por el restablecimiento administrativo
         con contraseña temporal (UsuarioServiceImpl.restablecerPassword). Filas
         existentes no necesitan cambiar nada, por eso default false sin backfill
         especial. -->
    <changeSet id="seguridad-012-usuario-debe-cambiar-password" author="market-backend">
        <addColumn tableName="usuario">
            <column name="debe_cambiar_password" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="seguridad-012-seed-permiso-restablecer-password" author="market-backend">
        <insert tableName="permiso">
            <column name="codigo" value="USUARIOS_RESTABLECER_PASSWORD"/>
            <column name="descripcion" value="Restablecer la contraseña de otro usuario con una contraseña temporal"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id"
                    valueComputed="(select id from permiso where codigo = 'USUARIOS_RESTABLECER_PASSWORD')"/>
        </insert>
    </changeSet>
</databaseChangeLog>
