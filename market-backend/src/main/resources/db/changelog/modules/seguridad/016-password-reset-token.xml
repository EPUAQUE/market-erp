<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        Token de un solo uso para el flujo público "olvidé mi contraseña"
        (AuthController.forgotPassword/resetPassword). Solo se persiste el hash
        SHA-256 del token (token_hash) — igual que refresh_token.token_hash — nunca el
        valor en claro, que solo viaja en el correo enviado al usuario.
    -->
    <changeSet id="seguridad-016-password-reset-token" author="market-backend">
        <createTable tableName="password_reset_token">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="token_hash" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_password_reset_token_hash"/>
            </column>
            <column name="creado_en" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="expira_en" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="usado" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="password_reset_token" baseColumnNames="usuario_id"
                referencedTableName="usuario" referencedColumnNames="id"
                constraintName="fk_password_reset_token_usuario" onDelete="CASCADE"/>
        <createIndex indexName="ix_password_reset_token_usuario" tableName="password_reset_token">
            <column name="usuario_id"/>
        </createIndex>
        <!-- Soporta una futura limpieza periódica de tokens expirados, mismo criterio
             que seguridad/008-refresh-token-index-expira-en.xml. -->
        <createIndex indexName="ix_password_reset_token_expira_en" tableName="password_reset_token">
            <column name="expira_en"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
