<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="unidadesmedida-001-unidad-medida" author="market-backend">
        <createTable tableName="unidad_medida">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nombre" type="VARCHAR(60)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_unidad_medida_nombre"/>
            </column>
            <column name="abreviacion" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="unidadesmedida-001-seed-permisos" author="market-backend">
        <insert tableName="permiso">
            <column name="codigo" value="UNIDADES_MEDIDA_VER"/>
            <column name="descripcion" value="Listar unidades de medida"/>
        </insert>
        <insert tableName="permiso">
            <column name="codigo" value="UNIDADES_MEDIDA_CREAR"/>
            <column name="descripcion" value="Crear unidades de medida"/>
        </insert>
        <insert tableName="permiso">
            <column name="codigo" value="UNIDADES_MEDIDA_EDITAR"/>
            <column name="descripcion" value="Editar unidades de medida"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'UNIDADES_MEDIDA_VER')"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'UNIDADES_MEDIDA_CREAR')"/>
        </insert>
        <insert tableName="rol_permiso">
            <column name="rol_id" valueComputed="(select id from rol where nombre = 'ADMIN')"/>
            <column name="permiso_id" valueComputed="(select id from permiso where codigo = 'UNIDADES_MEDIDA_EDITAR')"/>
        </insert>
    </changeSet>
</databaseChangeLog>
