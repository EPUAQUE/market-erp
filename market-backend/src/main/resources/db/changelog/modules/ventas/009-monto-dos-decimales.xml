<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Decisión del cliente: dinero físico se maneja a 2 decimales, nunca más —
         precio_unitario pasa de NUMERIC(12,4) a NUMERIC(12,2). Ver
         inventario/004-monto-dos-decimales.xml para el resto de montos del sistema.
         Precondición HALT a propósito: si algún día hay un precio real con más de 2
         decimales en producción, preferimos que el arranque falle fuerte a que la
         migración lo redondee en silencio. -->
    <changeSet id="ventas-009-monto-dos-decimales" author="market-backend">
        <preConditions onFail="HALT">
            <sqlCheck expectedResult="0">
                SELECT count(*) FROM linea_venta WHERE precio_unitario != ROUND(precio_unitario, 2)
            </sqlCheck>
        </preConditions>
        <sql>ALTER TABLE linea_venta ALTER COLUMN precio_unitario TYPE NUMERIC(12,2);</sql>
        <rollback>
            <sql>ALTER TABLE linea_venta ALTER COLUMN precio_unitario TYPE NUMERIC(12,4);</sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
